# AgentMesh
APP_NAME=AgentMesh

# PostgreSQL (asyncpg). Use the Neon DIRECT string (no -pooler): this app keeps a
# persistent asyncpg pool and runs DDL at boot, so PgBouncer pooled URLs are a bad fit.
# Local dev host = localhost; Docker compose overrides this.
DATABASE_URL=postgresql://agentmesh:agentmesh@localhost:5432/agentmesh
# Neon pooled URL (PgBouncer) - only for serverless/edge one-shot workers, NOT this app.
DATABASE_URL_POOLED=postgresql://...-pooler....neon.tech/db?sslmode=require

# Redis (semantic cache + MCP rate limiting).
# Local: redis://localhost:6379/0   ·   Upstash/Neon prod: rediss:// (TLS RESP string)
REDIS_URL=redis://localhost:6379/0

# Semantic cache
CACHE_SIMILARITY_THRESHOLD=0.88
CACHE_TTL_SECONDS=86400

# Prompt compression budget (tokens)
PROMPT_TOKEN_BUDGET=1800

# Router defaults when nothing is explicit
DEFAULT_PROVIDER=ollama
DEFAULT_MODEL=llama3.1

# Hosted providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Sarvam-1 (https://www.sarvam.ai) - enables Indic language routing
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_DEFAULT_MODEL=Sarvam 1

# Local provider
OLLAMA_BASE_URL=http://localhost:11434

# Control-plane auth
ADMIN_API_KEY=
# Set to false to enforce virtual keys everywhere (production)
ALLOW_NO_AUTH=true

# OpenTelemetry distributed tracing (optional; requires OTel packages)
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4318/v1/traces

# INR conversion for USD-priced models
USD_TO_INR_RATE=83.0
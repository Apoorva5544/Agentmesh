# Executed vendored from the repo root (e.g. `source scripts/deploy/koyeb.env.example`).

# --- Postgres: Neon (use the DIRECT connection string; see DEPLOY.md) ---
DATABASE_URL=postgresql://user:password@ep-xxx.ca-central-1.aws.neon.tech/agentmesh?sslmode=require

# --- Redis: Upstash (use the RESP/TLS URL, scheme is rediss://) ---
REDIS_URL=rediss://default:password@excited-snail-12345.upstash.io:6379

# --- LLM providers (ALL supported; leave the ones you don't have blank) ---
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
SARVAM_API_KEY=...
SARVAM_DEFAULT_MODEL=Sarvam 1

# --- Control-plane auth (REQUIRED for public exposure) ---
ADMIN_API_KEY=am-admin-CHANGE-ME-32-random-characters
ALLOW_NO_AUTH=false

# --- Neon-friendly connection pool (keep below Neon's free limit) ---
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

# --- Optional: OpenTelemetry (requires an OTLP collector) ---
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4318/v1/traces

# NOT used in this deployment (Ollama is dev-only):
#   DEFAULT_PROVIDER=ollama / DEFAULT_MODEL=llama3.1 / OLLAMA_BASE_URL